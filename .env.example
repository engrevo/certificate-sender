# ---- App ----
# كلمة مرور لحماية الموقع (مهم لو رفعته على الإنترنت)
APP_PASSWORD=
SECRET_KEY=change-me
# رمز الدولة الافتراضي لتحويل أرقام مثل 05xxxxxxxx
DEFAULT_COUNTRY_CODE=966
# ثواني الانتظار بين كل رسالة
SEND_DELAY_SECONDS=1
# 1 = وضع التجربة: ما يرسل شيء، يحفظ الشهادات في data/outbox
DRY_RUN=1

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# template = قالب رسالة معتمد (مطلوب لأول رسالة)، document = إرسال مباشر (داخل نافذة 24 ساعة فقط)
WHATSAPP_SEND_MODE=template
WHATSAPP_TEMPLATE_NAME=attendance_certificate
WHATSAPP_TEMPLATE_LANG=ar
# 1 = القالب فيه متغير {{1}} في النص يتعبى باسم الشخص
WHATSAPP_TEMPLATE_NAME_PARAM=1
